/**
 * @file version.h
 * @brief Firmware version, generated by CMake from version.h.in for each build.
 */
#ifndef ZEPHYRFORGE_APP_VERSION_H
#define ZEPHYRFORGE_APP_VERSION_H

/** Firmware version as MAJOR.MINOR.PATCH: the release tag, or the development default. */
#define ZEPHYRFORGE_VERSION "@ZEPHYRFORGE_VERSION@"
/** Major version component, 0 to 255. */
#define ZEPHYRFORGE_VERSION_MAJOR @ZEPHYRFORGE_VERSION_MAJOR@
/** Minor version component, 0 to 255. */
#define ZEPHYRFORGE_VERSION_MINOR @ZEPHYRFORGE_VERSION_MINOR@
/** Patch version component, 0 to 255. */
#define ZEPHYRFORGE_VERSION_PATCH @ZEPHYRFORGE_VERSION_PATCH@

#endif
