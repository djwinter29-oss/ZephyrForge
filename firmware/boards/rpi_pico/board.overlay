/*
 * Raspberry Pi Pico family: management USB HID and die-temperature sensor. This overlay adds no GPIO pin assignments.
 */
&zephyr_udc0 {
	zephyrforge_hid: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "ZephyrForge";
		protocol-code = "none";
		in-report-size = <64>;
		in-polling-period-us = <4000>;
	};
};

coretemp: &die_temp {
	status = "okay";
};
